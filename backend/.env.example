PROJECT_NAME="MedNex API"
TAGLINE="Smarter Healthcare. Better Decisions"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
SECRET_KEY="temporary-dev-secret-key-change-in-production-for-mednex"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for development, PostgreSQL production compatible)
DATABASE_URL="sqlite:///./mednex.db"

# CORS Configuration (Allowed origins for React frontend)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Target Geographic Deployment & Emergency
DEPLOYMENT_DIVISION="Khulna Division"
EMERGENCY_DISPATCH_HOTLINE="999"

# Mandatory Clinical Safety Disclaimer (NFR-15)
MEDICAL_DISCLAIMER="MedNex provides intelligent triage and health literacy support, not clinical diagnosis or medical prescriptions."
