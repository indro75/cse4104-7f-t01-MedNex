# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Regional Localization & Emergency Contacts
DEPLOYMENT_HUB="Khulna Division, Bangladesh"
EMERGENCY_HOTLINE="999"

# Core Medical Safety Disclaimer (Mandatory)
MEDICAL_DISCLAIMER="MedNex serves as an initial assistance and informational tool. It does not replace professional medical consultation, provide clinical diagnoses, or prescribe medication."

# Database & Supabase Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mednex
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Authentication
JWT_SECRET=temporary-dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
